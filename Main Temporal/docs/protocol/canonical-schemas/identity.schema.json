{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpg://schema/identity/0.1.0",
  "title": "Chain Poker Genesis Cryptographic Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity_id",
    "identity_version",
    "identity_status"
  ],
  "properties": {
    "identity_id": {
      "type": "string",
      "minLength": 1
    },
    "identity_version": {
      "type": "string",
      "minLength": 1
    },
    "identity_status": {
      "type": "string",
      "enum": [
        "INITIALIZING",
        "VALIDATED",
        "ACTIVE",
        "REVOKED",
        "RECOVERY_REQUIRED"
      ]
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "HARDWARE_WALLET",
        "GENERATED_KEY_PAIR",
        "IMPORTED_PRIVATE_KEY",
        "BIP39_SEED",
        "SEED_PHRASE"
      ]
    },
    "public_key": {
      "type": "string",
      "minLength": 1
    },
    "signature_scheme": {
      "type": "string",
      "minLength": 1
    },
    "key_reference": {
      "type": "string",
      "minLength": 1
    }
  }
}
