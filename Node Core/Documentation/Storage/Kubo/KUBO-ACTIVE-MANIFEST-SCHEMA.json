{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kubo Active Installation Manifest",
  "type": "object",
  "required": [
    "manifest_type", "manifest_version", "installation_id", "provider",
    "version", "platform", "architecture", "package_sha512",
    "installation_root", "executable_path", "repository_path",
    "ipfs_path", "repository_initialized", "process_started"
  ],
  "properties": {
    "manifest_type": {"const": "KUBO-ACTIVE-INSTALLATION-MANIFEST"},
    "manifest_version": {"const": "1.0.0"},
    "installation_id": {"type": "string", "minLength": 1},
    "provider": {"const": "Kubo"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "platform": {"const": "linux"},
    "architecture": {"enum": ["amd64", "arm64"]},
    "package_sha512": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "installation_root": {"type": "string", "minLength": 1},
    "executable_path": {"type": "string", "minLength": 1},
    "repository_path": {"type": "string", "minLength": 1},
    "ipfs_path": {"type": "string", "minLength": 1},
    "repository_initialized": {"const": false},
    "process_started": {"const": false}
  },
  "additionalProperties": false
}
