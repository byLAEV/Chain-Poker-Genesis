{
  "provider": "Kubo",
  "ecosystem": "IPFS",
  "upstream_repository": "https://github.com/ipfs/kubo",
  "upstream_license": [
    "Apache-2.0",
    "MIT"
  ],
  "integration_type": "external_provider_adapter_and_managed_node",
  "node_core_owns": [
    "storage_api",
    "storage_manager",
    "storage_policy",
    "canonical_object_metadata",
    "local_provider",
    "coherence",
    "synchronization_state",
    "retry_and_recovery_policy",
    "authorization_boundary"
  ],
  "kubo_owns": [
    "ipfs_daemon",
    "kubo_repository",
    "datastore",
    "blockstore",
    "bitswap",
    "libp2p_integration",
    "routing",
    "gateway",
    "rpc",
    "cli",
    "kubo_configuration"
  ],
  "required_adapter_capabilities": [
    "put",
    "get",
    "has",
    "stat",
    "remove",
    "pin",
    "unpin",
    "resolve",
    "verify",
    "health",
    "version"
  ],
  "read_policy": {
    "primary": "kubo_when_available_and_integrity_valid",
    "fallback": "local_node_storage",
    "conflict": "do_not_silently_overwrite"
  },
  "installation_policy": {
    "silent_install": false,
    "provider_optional_at_baseline": true,
    "managed_install_supported": true,
    "release_selection": "latest_compatible_stable_at_install_time",
    "package_verification_required": true,
    "explicit_ipfs_path": true,
    "repository_location": "node-storage/providers/kubo/repository/",
    "activation_requires_initial_sync": true
  },
  "node_core_managed_paths": {
    "installation": "External Providers/Kubo/<kubo-version>/",
    "repository": "node-storage/providers/kubo/repository/",
    "runtime": "node-storage/providers/kubo/runtime/",
    "logs": "node-storage/providers/kubo/logs/",
    "state": "node-storage/providers/kubo/state/",
    "synchronization": "node-storage/providers/kubo/synchronization/"
  },
  "provider_modes": [
    "LOCAL_ONLY",
    "DUAL_STORAGE"
  ],
  "dual_storage_activation_requirements": [
    "kubo_installed",
    "repository_initialized",
    "provider_healthy",
    "initial_sync_complete",
    "integrity_verified",
    "no_unresolved_sync_conflict"
  ],
  "platform_order": [
    "linux",
    "windows",
    "ios"
  ]
}
