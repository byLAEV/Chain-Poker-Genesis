{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpg://schema/event/0.1.0",
  "title": "Chain Poker Genesis Canonical Protocol Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "protocol_version",
    "timestamp",
    "actor_id",
    "scope_id",
    "sequence",
    "payload_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "previous_event_id": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash": {
      "type": "string",
      "minLength": 1
    },
    "state_hash": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "AUTHORIZED_PRIVATE"
      ]
    }
  }
}
